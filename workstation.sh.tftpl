```bash
#!/bin/bash
set -e

growpart /dev/nvme0n1 4
lvextend -L +30G /dev/RootVG/varVol
xfs_growfs /var

# Docker
dnf -y install dnf-plugins-core
dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
dnf install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin -y
systemctl enable --now docker
usermod -aG docker ec2-user

# Install eksctl
ARCH=amd64
PLATFORM=$(uname -s)_$ARCH

curl -sLO "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_${PLATFORM}.tar.gz"
tar -xzf "eksctl_${PLATFORM}.tar.gz" -C /tmp
install -m 0755 /tmp/eksctl /usr/local/bin/eksctl
rm -f "eksctl_${PLATFORM}.tar.gz" /tmp/eksctl

# Install kubectl (client)
curl -fLo /usr/local/bin/kubectl \
  https://dl.k8s.io/release/v1.36.0/bin/linux/amd64/kubectl
chmod +x /usr/local/bin/kubectl

# Install kubens
curl -sLo /tmp/kubens https://raw.githubusercontent.com/ahmetb/kubectx/master/kubens
install -m 0755 /tmp/kubens /usr/local/bin/kubens
rm -f /tmp/kubens

# Install k9s
curl -sLO https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_amd64.tar.gz
tar -xzf k9s_Linux_amd64.tar.gz -C /tmp k9s
install -m 0755 /tmp/k9s /usr/local/bin/k9s
rm -f k9s_Linux_amd64.tar.gz /tmp/k9s

# Configure AWS credentials for ec2-user
mkdir -p /home/ec2-user/.aws

cat > /home/ec2-user/.aws/credentials <<EOF
[default]
aws_access_key_id = ${aws_access_key}
aws_secret_access_key = ${aws_secret_key}
EOF

cat > /home/ec2-user/.aws/config <<EOF
[default]
region = us-east-1
output = json
EOF

chown -R ec2-user:ec2-user /home/ec2-user/.aws
chmod 600 /home/ec2-user/.aws/credentials
chmod 600 /home/ec2-user/.aws/config

# Clone YOUR repository
cd /home/ec2-user
sudo -u ec2-user git clone https://github.com/naveen77991/eksctl.git
cd /home/ec2-user/eksctl

# Verify configured EKS version before creation
grep -A 4 '^metadata:' eksctl.yaml

# Create EKS cluster using version specified in eksctl.yaml
sudo -u ec2-user /usr/local/bin/eksctl create cluster -f /home/ec2-user/eksctl/eksctl.yaml

# Configure kubectl
sudo -u ec2-user aws eks update-kubeconfig \
  --region us-east-1 \
  --name roboshop

# Verify cluster and nodes
sudo -u ec2-user /usr/local/bin/kubectl get nodes
```
